{
  "name": "nh-data-site",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/vendor-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/vendor-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/apply_csp.mjs",
    "data": "python3 scripts/build_data.py",
    "fixture": "python3 scripts/dev_fixture.py && NH_PARTITION_MIN_BYTES=500 NH_OWNER_PAGE_MIN=2 NH_METHODS_FACILITY_MIN=2 NH_STATE_URL= python3 scripts/build_data.py --zip build/fixture/theme_fixture.zip",
    "check:loop": "python3 scripts/check_loop_guard.py",
    "check:doc": "python3 scripts/check_project_doc.py",
    "check:prose": "python3 scripts/check_prose_style.py",
    "check:origins": "node scripts/check_no_third_party.mjs",
    "test:data": "python3 scripts/test_build_data.py",
    "check:rendered": "node scripts/check_rendered_values.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.6.0"
  }
}
